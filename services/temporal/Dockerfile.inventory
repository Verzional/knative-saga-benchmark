FROM golang:1.24-alpine AS builder
WORKDIR /app
RUN go mod init serverless-saga-bench/services/temporal/inventory_service && \
    go get github.com/google/uuid@v1.6.0
COPY inventory_service/main.go .
RUN go mod tidy
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /inventory-service main.go

FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /root/
COPY --from=builder /inventory-service ./main
EXPOSE 8080
CMD ["./main"]
