        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "⚡ Real-Time System Under Test (SUT) Status: Lenovo Legion 5 Pro",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 4 },
              { "color": "red", "value": 8 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"default|temporal|kafka\"}[30s])) or vector(0)",
          "legendFormat": "Total SUT Cores In-Use",
          "refId": "A"
        }
      ],
      "title": "Total SUT CPU Cores (In-Use)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 4294967296 },
              { "color": "red", "value": 8589934592 }
            ]
          },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"default|temporal|kafka\"}) or vector(0)",
          "legendFormat": "Active Working Set RAM",
          "refId": "A"
        }
      ],
      "title": "Total SUT RAM Working Set",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Active Pods",
            "drawStyle": "line",
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "lineWidth": 2
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (service) (knative_serving_revision_actual_pods) or sum(kube_pod_status_phase{phase=\"Running\", namespace=\"default\"}) or vector(0)",
          "legendFormat": "Active Knative Pods (Scale-to-Zero)",
          "refId": "A"
        }
      ],
      "title": "Knative Scale-to-Zero Status",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 50 },
              { "color": "red", "value": 150 }
            ]
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "sum(rate(knative_serving_app_request_count[10s])) or vector(0)",
          "legendFormat": "Live Traffic RPS",
          "refId": "A"
        }
      ],
      "title": "Ingress Throughput (RPS)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "⏱️ Latency & Execution Breakdown (Le2e, Cold Start, Rollback)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "Latency",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(knative_serving_app_request_latencies_bucket[30s])) by (le))",
          "legendFormat": "p50 (Median Latency)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(knative_serving_app_request_latencies_bucket[30s])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(knative_serving_app_request_latencies_bucket[30s])) by (le))",
          "legendFormat": "p99 Tail Latency",
          "refId": "C"
        }
      ],
      "title": "End-to-End Latency Percentiles (p50, p95, p99)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "Requests / Sec",
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "targets": [
        {
          "expr": "sum by (response_code) (rate(knative_serving_app_request_count{response_code=\"200\"}[30s]))",
          "legendFormat": "HTTP 200 OK (Completed)",
          "refId": "A"
        },
        {
          "expr": "sum by (response_code) (rate(knative_serving_app_request_count{response_code=\"202\"}[30s]))",
          "legendFormat": "HTTP 202 Accepted (Kafka Buffered)",
          "refId": "B"
        },
        {
          "expr": "sum by (response_code) (rate(knative_serving_app_request_count{response_code=\"422\"}[30s]))",
          "legendFormat": "HTTP 422 Compensated (Rollback)",
          "refId": "C"
        },
        {
          "expr": "sum by (response_code) (rate(knative_serving_app_request_count{response_code=\"503\"}[30s]))",
          "legendFormat": "HTTP 503 Overload (Fast-Fail)",
          "refId": "D"
        }
      ],
      "title": "Throughput by Response Code (Success, Buffer, Compensation, Fast-Fail)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "📊 Compute Footprint: Temporal vs Kafka Orchestration Stacks",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "CPU Cores",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"temporal\"}[30s]))",
          "legendFormat": "Temporal Stack (Orchestration)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"kafka\"}[30s]))",
          "legendFormat": "Kafka Stack (Choreography)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"knative-serving\"}[30s]))",
          "legendFormat": "Knative Ingress & Activator",
          "refId": "C"
        }
      ],
      "title": "CPU Consumption by Coordination Paradigm",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Working Set RAM",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 15 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"temporal\"})",
          "legendFormat": "Temporal Stack RAM",
          "refId": "A"
        },
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"kafka\"})",
          "legendFormat": "Kafka Stack RAM",
          "refId": "B"
        },
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"knative-serving\"})",
          "legendFormat": "Knative Serving RAM",
          "refId": "C"
        }
      ],
      "title": "Memory Footprint by Coordination Paradigm",
      "type": "timeseries"
    }
  ],
  "refresh": "2s",
